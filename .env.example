# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini (Ghanwa) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MAX_CHAT_HISTORY=20
MAX_TOOL_CALLS=5

# --- RAG / document Q&A (Ghanwa) ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
MAX_UPLOAD_SIZE_MB=10

# --- Supabase (Rabia) ---
SUPABASE_URL=
SUPABASE_KEY=
# service_role/secret key, used only server-side for face-login matching
# (db/face_auth.py). Do NOT reuse this as SUPABASE_KEY above.
SUPABASE_SERVICE_KEY=

# Note: weather lookup (tools/weather.py) uses Open-Meteo, which needs no
# API key. WEATHER_API_KEY is no longer used.
