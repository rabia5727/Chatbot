# Template for Streamlit Community Cloud's Secrets manager.
#
# This file is just documentation -- don't fill in real values here or
# commit a real secrets.toml (it's gitignored). On Streamlit Cloud:
# App settings -> Secrets -> paste this content with real values filled
# in. Streamlit exposes these as environment variables to the running
# app, which is exactly what config/settings.py already reads -- no code
# changes needed to deploy.
#
# Keys must stay flat (no [section] headers) so they map directly to the
# env var names config/settings.py expects.

GEMINI_API_KEY = ""

SUPABASE_URL = ""
SUPABASE_KEY = ""
SUPABASE_SERVICE_KEY = ""
